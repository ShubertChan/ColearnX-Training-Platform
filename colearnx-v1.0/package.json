{
  "name": "colearnx-web-prototype",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "node --test \"src/**/*.test.js\"",
    "test:components": "vitest run --config vitest.config.js --configLoader native",
    "test:e2e": "playwright test",
    "api:build": "npm --prefix apps/api run build",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "api:test": "npm --prefix apps/api test",
    "db:migrate": "npm --prefix apps/api run db:migrate",
    "db:seed": "npm --prefix apps/api run db:seed",
    "release:test": "node --test scripts/deployment/*.test.mjs",
    "release:build": "node scripts/deployment/artifact.mjs build",
    "release:verify": "node scripts/deployment/artifact.mjs verify",
    "release:smoke": "node scripts/deployment/smoke.mjs",
    "release:database-test": "npm --prefix apps/api run test:integration"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@stripe/react-stripe-js": "7.0.0",
    "@stripe/stripe-js": "10.1.0",
    "axios": "^1.20.0",
    "gsap": "^3.15.0",
    "hls.js": "1.7.3",
    "lucide-react": "^0.542.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "30.1.0",
    "vite": "^7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
