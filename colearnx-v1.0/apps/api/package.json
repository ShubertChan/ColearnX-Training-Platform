{
  "name": "@colearnx/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:integration:upload-retry": "node --import tsx scripts/upload-retry-permissions-integration-check.mjs",
    "test:integration": "node --import tsx scripts/release-integration-check.mjs",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "storage:reconcile": "tsx src/storage/reconcile.ts",
    "security:retention": "tsx src/security/retention.ts",
    "security:ledger-audit": "tsx src/security/ledger-audit-run.ts",
    "security:risk-sweep": "tsx src/security/risk-sweep-run.ts",
    "security:download-audit": "tsx src/security/download-audit-run.ts",
    "security:upload-backfill": "tsx src/security/upload-backfill-run.ts",
    "video:queue:prepare": "tsx src/video/prepare-queue.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "11.3.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-boss": "12.33.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "stripe": "^22.6.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
