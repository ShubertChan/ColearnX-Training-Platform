NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001

# Docker Compose provides the local database. Do not use the owner account in the API.
DATABASE_URL=postgresql://colearnx_app:replace_me@localhost:5433/colearnx
MIGRATION_DATABASE_URL=postgresql://colearnx_owner:replace_me@localhost:5433/colearnx
DATABASE_SSL=false
DB_POOL_MAX=10
TRUST_PROXY=1

ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters
REFRESH_TOKEN_SECRET=replace_with_a_different_32_character_random_value
CSRF_SECRET=replace_with_at_least_32_random_characters
COOKIE_DOMAIN=

# One-time local/admin bootstrap. Register this email first, run db:seed once,
# then remove the value. It is never a default account or password.
BOOTSTRAP_ADMIN_EMAIL=

# Stripe test-mode values only. Leave blank until a Stripe test account is configured.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=sgd
STRIPE_MODE=test

# Email verification uses Resend's HTTP API. Keep these values only in the
# deployment platform's secret manager. Configure a verified sender address
# before setting EMAIL_PROVIDER=resend in staging or production.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_VERIFICATION_CODE_PEPPER=replace_with_a_separate_random_value_of_at_least_32_characters
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Cloudflare R2 private object storage. Keep credentials only in a local secret
# file or the deployment platform's secret manager; never expose them as VITE_*.
OBJECT_STORAGE_PROVIDER=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_SIGNED_UPLOAD_TTL_SECONDS=600
R2_SIGNED_DOWNLOAD_TTL_SECONDS=300
CONTENT_UPLOAD_MAX_BYTES=26214400
CONTENT_VIDEO_UPLOAD_MAX_BYTES=104857600
CONTENT_STORAGE_QUOTA_BYTES=524288000
CONTENT_PENDING_UPLOAD_LIMIT=3

ENABLE_LOCAL_DELIVERY=false
ENABLE_HOSTED_VIDEO=false
LOG_LEVEL=info
