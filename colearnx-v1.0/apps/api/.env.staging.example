# Render staging API configuration. Enter actual secret values only in Render's
# Environment page; this committed template must remain secret-free.
NODE_ENV=staging
# Render injects PORT. Do not set a fixed production port unless the host requires it.
PORT=10000
APP_ORIGIN=https://colearnx-staging.pages.dev
API_ORIGIN=https://colearnx-api-staging.onrender.com

# Runtime: use the restricted Neon colearnx_app role only.
DATABASE_URL=postgresql://colearnx_app:replace_with_render_secret@your-neon-host/colearnx?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=5
# Render forwards one trusted proxy hop to the Express service.
TRUST_PROXY=1

# Only a controlled migration job may use this direct/unpooled, high-privilege URL.
# Do not add it to the long-running API service unless a deployment task needs it.
MIGRATION_DATABASE_URL=postgresql://neon_owner_or_migrator:replace_with_controlled_secret@your-neon-host/colearnx?sslmode=require

ACCESS_TOKEN_SECRET=replace_with_a_unique_random_value_of_at_least_32_characters
REFRESH_TOKEN_SECRET=replace_with_a_different_random_value_of_at_least_32_characters
CSRF_SECRET=replace_with_a_different_random_value_of_at_least_32_characters
# Keep blank for the Pages-to-Render staging domains; the refresh cookie is host-only.
COOKIE_DOMAIN=

# Set only for the one-time first-admin seed, then remove immediately.
BOOTSTRAP_ADMIN_EMAIL=

# Optional for this phase. The non-payment API starts when these are blank.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=sgd
STRIPE_MODE=test

ENABLE_LOCAL_DELIVERY=false
ENABLE_HOSTED_VIDEO=false
LOG_LEVEL=info
