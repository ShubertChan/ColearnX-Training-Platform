# Server-only credentials. Keep the real file outside Git, on the D: volume.
VIDEO_WORKER_DATABASE_URL=postgresql://colearnx_video_worker:REPLACE_ME@REPLACE_ME/colearnx?sslmode=verify-full
# VIDEO_QUEUE_DATABASE_URL may be omitted to reuse the restricted worker URL.
DATABASE_SSL=true
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=REPLACE_ME
R2_REGION=auto
VIDEO_HLS_BUCKET_NAME=REPLACE_ME
VIDEO_WORKER_CONCURRENCY=1
VIDEO_TRANSCODE_TIMEOUT_MS=18000000
# 0 = continuous service; 30..86400 = idle exit. Local batch compose pins 120.
VIDEO_WORKER_IDLE_EXIT_SECONDS=120
