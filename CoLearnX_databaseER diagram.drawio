        <mxCell id="payment_note" parent="1" style="text;html=1;strokeColor=#D0D5DD;fillColor=#F8FAFC;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#344054;fontStyle=0;spacing=5;" value="Payment rule&lt;br&gt;purchases records the item/order. point_transactions records every balance movement. A course purchase creates 0..1 enrolment; a content purchase creates 0..1 access row; one purchase can create multiple point transactions." vertex="1">
          <mxGeometry height="140" width="1120" x="1100" y="1610" as="geometry" />
        </mxCell>
